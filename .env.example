# Required: OpenAI API key for the LLM stages (intake, compose, repair, render).
OPENAI_API_KEY=sk-...

# Which tenant knowledge base to load from kb/tenants/.
TENANT_ID=wanderingyaks

# Model used by every LLM stage. See docs/REPRODUCTION.md for measured cost per run.
MODEL=gpt-5

# Outbound sending. "simulate" writes to the local log and transmits nothing.
# Switching to "live" additionally requires a recorded operator approval; there is
# no flag that bypasses the approval gate.
SEND_MODE=simulate
